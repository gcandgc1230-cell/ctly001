{
  "name": "dsh-plugin-organizer",
  "version": "0.1.0",
  "description": "Upgrades the Plugins page Installed area with categories, drag-and-drop ordering, search/filter, favorites, and durable layout persistence.",
  "type": "module",
  "license": "MIT",
  "author": "Brian (gcandgc1230-cell)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gcandgc1230-cell/ctly001.git"
  },
  "homepage": "https://github.com/gcandgc1230-cell/ctly001",
  "bugs": {
    "url": "https://github.com/gcandgc1230-cell/ctly001/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "plugins",
    "organizer",
    "categories",
    "ui"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "vendor/**",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  }
}
